{
  "name": "solgil-websites",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "sites/moho",
    "sites/portfolio"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "bash scripts/cloud-setup.sh",
    "dev:moho": "npm run dev --workspace=@solgil/moho -- --host 0.0.0.0",
    "dev:portfolio": "npm run dev --workspace=@solgil/portfolio -- --host 0.0.0.0 --port 4322",
    "build": "node scripts/build-sites.mjs",
    "build:moho": "node scripts/build-sites.mjs moho",
    "build:portfolio": "node scripts/build-sites.mjs portfolio"
  }
}
