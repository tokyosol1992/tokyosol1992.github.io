---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection, render } from 'astro:content';
import { getItems } from '../../lib/items';

export async function getStaticPaths() {
  const items = await getCollection('work', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const item = (await getItems()).find((i) => i.kind === 'work' && i.id === entry.id)!;
---
<Base title={d.title} description={d.summary}>
  <Entry item={item} meta={[d.company, d.role, d.period].filter(Boolean).join(' · ')}>
    <Content />
  </Entry>
</Base>
