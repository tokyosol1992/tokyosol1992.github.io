---
// 실제 /portfolio/ 페이지 = OSOL LIBRARY 서가(2026-11-18 사용자 배포 결정).
// 원본은 하나다: mockups/portfolio-shelf.src.html (Claude 아티팩트 게시본과 같은 파일). 그 파일을 고치면 이 페이지도 바뀐다.
// 원본의 앞부분(<title>·글꼴·<style>)은 <head>로, 나머지(본문·<script>)는 <body>로 그대로 넣는다(Astro가 손대지 않음).
// SUIT 부분 글꼴은 원본 안에 들어 있다. 문구를 바꾸면 mockups/suit-subset.py로 다시 만든다.
// 이전 다크 한 페이지는 src/legacy/index-dark-2026-11-06.astro에 보존(경로 없음).
import shelf from '../../mockups/portfolio-shelf.src.html?raw';

const cut = shelf.indexOf('</style>') + '</style>'.length;
const head = shelf.slice(0, cut).replace(/<meta name="claude:viewport-fit-sides"[^>]*>\s*/, '');
const body = shelf.slice(cut);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e7e5df" />
    <meta name="description" content="OSOL LIBRARY — 선택한 작업을 서가에 꽂아 둔 포트폴리오" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Fragment set:html={head} />
  </head>
  <body>
    <Fragment set:html={body} />
  </body>
</html>
