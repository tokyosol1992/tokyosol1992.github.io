---
import { Image } from 'astro:assets';
import { getCategory } from '../lib/categories';
import { kindLabel, formatDate, type Item } from '../lib/items';
import { url } from '../lib/url';

interface Props { item: Item; }
const { item } = Astro.props;
const cat = getCategory(item.category);
const search = [item.title, item.summary, cat.label, ...item.tags].join(' ').toLowerCase();
---
<a
  class="card"
  href={url(item.href)}
  style={`--h: ${cat.hue}`}
  data-kind={item.kind}
  data-search={search}
>
  <div class="thumb">
    {item.cover
      ? <Image src={item.cover} alt="" widths={[480, 960]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px" />
      : <span class="ph" aria-hidden="true">{cat.label}</span>}
  </div>
  <div class="body">
    <div class="meta">
      <span class="badge">{cat.label}</span>
      <span>{kindLabel[item.kind]}</span>
      {item.date && <span>{formatDate(item.date)}</span>}
    </div>
    <h3>{item.title}</h3>
    {item.summary && <p>{item.summary}</p>}
    {item.tags.length > 0 && <div class="tags">{item.tags.map((t) => <span>{t}</span>)}</div>}
  </div>
</a>
