---
/**
 * 홈 히어로: Three.js 오브젝트 + HUD.
 * 지금 오브젝트는 페르소나가 나오기 전 임시 코어. 3D 페르소나(.glb)가 준비되면
 * src/scripts/hero-scene.ts 의 createCore()만 모델 로더로 바꾸면 됨.
 */
import { materials } from '../scripts/hero-materials';
---
<section class="hero3d" data-hero>
  <div class="fallback" aria-hidden="true"></div>
  <div class="ui">
    <div class="top mono">
      <div>
        <div>product designer</div>
        <div class="muted">platform · design system</div>
      </div>
      <div class="stats" data-stats aria-live="polite">
        {materials[0].stats.map((s) => (
          <div><span>{s.label}</span><b data-stat>{s.value}%</b></div>
        ))}
      </div>
    </div>
    <div></div>
    <div class="bottom">
      <div data-hero-copy>
        <span class="mono persona-tag">obj_01 · solgil.core</span>
        <h1 class="title">SOLGIL</h1>
        <p class="tagline">플랫폼과 디자인 시스템을 만드는<br /> 프로덕트 디자이너 솔길입니다.</p>
      </div>
      <div class="materials" role="group" aria-label="오브젝트 재질">
        {materials.map((m, i) => (
          <button type="button" data-material={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span>[{String(i + 1).padStart(2, '0')}]</span>{m.label}
          </button>
        ))}
        <a class="mono scroll-cue" href="#index">[scroll down ↓]</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { materials } from '../scripts/hero-materials';
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-material]')];
  const statEls = [...root.querySelectorAll<HTMLElement>('[data-stats] > div')];
  let setMaterial: (i: number) => void = () => {};

  // 3D는 지연 로드 (첫 화면 텍스트를 먼저 그림)
  import('../scripts/hero-scene').then(({ mountHero }) => {
    const api = mountHero(root);
    if (api) {
      root.querySelector('.fallback')?.remove();
      setMaterial = api.setMaterial;
    }
  });

  const select = (i: number) => {
    buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    materials[i].stats.forEach((s, j) => {
      const el = statEls[j];
      if (!el) return;
      el.querySelector('span')!.textContent = s.label;
      const b = el.querySelector<HTMLElement>('[data-stat]')!;
      const from = { v: parseInt(b.textContent ?? '0') };
      gsap.to(from, { v: s.value, duration: 0.6, ease: 'power2.out', onUpdate: () => { b.textContent = `${Math.round(from.v)}%`; } });
    });
    setMaterial(i);
  };
  buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));
  window.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    const n = Number(e.key);
    if (n >= 1 && n <= materials.length) select(n - 1);
  });
</script>
