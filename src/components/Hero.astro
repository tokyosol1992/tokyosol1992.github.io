---
/**
 * 홈 히어로: 페르소나 사진(SOLGIL.EXE)을 Three.js 셰이더 평면에 올리고 HUD를 입힘.
 * 스캔 모드 전환 · 얼굴 레티클 · 홀로그램 UI 패널 → src/scripts/hero-scene.ts
 * WebGL이 없거나 로드 전에는 같은 사진을 <Image>로 보여줌.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/persona/portrait.webp';
import { modes } from '../scripts/hero-modes';
---
<section class="hero3d" data-hero data-portrait={portrait.src}>
  <Image class="fallback" src={portrait} alt="" widths={[600, 1100]} sizes="(max-width: 760px) 80vw, 600px" loading="eager" />
  <div class="ui">
    <div class="top mono">
      <div>
        <div>product designer</div>
        <div class="muted">platform · design system</div>
        <div class="stats" data-stats aria-live="polite">
          {modes[0].stats.map((s) => (
            <div><span>{s.label}</span><b data-stat>{s.value}%</b></div>
          ))}
        </div>
      </div>
    </div>
    <div></div>
    <div class="bottom">
      <div data-hero-copy>
        <span class="mono persona-tag">subj_01 · solgil.exe</span>
        <h1 class="title">SOLGIL</h1>
        <p class="tagline">플랫폼과 디자인 시스템을 만드는<br /> 프로덕트 디자이너 솔길입니다.</p>
      </div>
      <div class="modes" role="group" aria-label="스캔 모드">
        {modes.map((m, i) => (
          <button type="button" data-mode={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span>[{String(i + 1).padStart(2, '0')}]</span>{m.label}
          </button>
        ))}
        <a class="mono scroll-cue" href="#index">[scroll down ↓]</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { modes } from '../scripts/hero-modes';
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
  const statEls = [...root.querySelectorAll<HTMLElement>('[data-stats] > div')];
  let setMode: (i: number) => void = () => {};

  // 3D는 지연 로드 (첫 화면 텍스트·사진을 먼저 그림)
  import('../scripts/hero-scene').then(async ({ mountHero }) => {
    const api = await mountHero(root, root.dataset.portrait!);
    if (api) {
      root.querySelector('.fallback')?.remove();
      setMode = api.setMode;
    }
  });

  const select = (i: number) => {
    buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    modes[i].stats.forEach((s, j) => {
      const el = statEls[j];
      if (!el) return;
      el.querySelector('span')!.textContent = s.label;
      const b = el.querySelector<HTMLElement>('[data-stat]')!;
      const from = { v: parseInt(b.textContent ?? '0') };
      gsap.to(from, { v: s.value, duration: 0.6, ease: 'power2.out', onUpdate: () => { b.textContent = `${Math.round(from.v)}%`; } });
    });
    setMode(i);
  };
  buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));
  window.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    const n = Number(e.key);
    if (n >= 1 && n <= modes.length) select(n - 1);
  });
</script>
