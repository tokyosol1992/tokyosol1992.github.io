---
import Row from './Row.astro';
import { kindLabel, type Item } from '../lib/items';

interface Props {
  items: Item[];
  /** 케이스 스터디 / 노트 필터 칩 표시 여부 */
  kindFilter?: boolean;
  /** 검색창 표시 여부 */
  search?: boolean;
}
const { items, kindFilter = true, search = true } = Astro.props;
const kinds = (['work', 'archive'] as const)
  .map((k) => ({ kind: k, label: kindLabel[k], count: items.filter((i) => i.kind === k).length }))
  .filter((k) => k.count > 0);
---
<section class="library" data-library>
  {(kindFilter && kinds.length > 1 || search) && (
    <div class="toolbar">
      {kindFilter && kinds.length > 1 && (
        <div class="chips" role="group" aria-label="글 형식">
          <button type="button" data-kind-btn="" aria-pressed="true">전체<small>{items.length}</small></button>
          {kinds.map((k) => (
            <button type="button" data-kind-btn={k.kind} aria-pressed="false">{k.label}<small>{k.count}</small></button>
          ))}
        </div>
      )}
      {search && <input class="search" type="search" placeholder="검색 (제목, 태그…)" aria-label="검색" data-search-input />}
    </div>
  )}
  <p class="count mono"><b data-count>{items.length}</b> 개의 항목</p>

  {items.length > 0
    ? <ul class="list">{items.map((item, i) => <Row item={item} index={i} />)}</ul>
    : <p class="empty muted">아직 글이 없어요.</p>}
  <p class="empty muted" data-no-result hidden>조건에 맞는 글이 없어요.</p>
</section>

<script>
  // 페이지 전환 뒤에도 다시 연결되도록 astro:page-load마다 실행
  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-library]')) {
      const rows = [...root.querySelectorAll<HTMLElement>('li[data-kind]')];
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-kind-btn]')];
      const input = root.querySelector<HTMLInputElement>('[data-search-input]');
      const count = root.querySelector<HTMLElement>('[data-count]');
      const noResult = root.querySelector<HTMLElement>('[data-no-result]');
      let kind = '';

      const apply = () => {
        const q = (input?.value ?? '').trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const ok = (!kind || row.dataset.kind === kind) && (!q || row.dataset.search!.includes(q));
          row.hidden = !ok;
          if (ok) shown++;
        }
        if (count) count.textContent = String(shown);
        if (noResult) noResult.hidden = shown > 0 || rows.length === 0;
      };

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          kind = btn.dataset.kindBtn ?? '';
          for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
          apply();
        });
      }
      input?.addEventListener('input', apply);
    }
  });
</script>
