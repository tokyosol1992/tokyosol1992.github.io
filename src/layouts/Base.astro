---
import '../styles/tailwind.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { url } from '../lib/url';
import { categories } from '../lib/categories';
import suitWoff2 from '../assets/fonts/suit/SUIT-Variable.woff2?url';

interface Props { title?: string; description?: string; flush?: boolean; header?: boolean; }
// header={false}: 상단 헤더 없이 (홈은 하프톤 메인이 메뉴를 겸함)
const { title, description = '솔길 · Product Designer 포트폴리오', flush = false, header = true } = Astro.props;
const siteName = '솔길';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} · Product Designer`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
// 메뉴 = 항목(categories.ts) + About. 레퍼런스: huddling.ai 상단 메뉴
const menu = [
  ...categories.map((c) => ({ href: `/category/${c.slug}`, label: c.label })),
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={suitWoff2} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Silkscreen&display=swap" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="pt" data-pt aria-hidden="true" transition:persist="pt">
      <div class="pt-dim" data-pt-dim></div>
      <div class="pt-ret" data-pt-ret><i></i><i></i><i></i><i></i><u></u><u></u><u></u><u></u><span class="pt-tag mono" data-pt-tag></span></div>
    </div>
    {header && <header class="site" transition:persist="header">
      <div class="wrap">
        <a class="logo" href={url('/')} data-scramble>SOLGIL<b>_</b></a>
        <nav class="menu" aria-label="메뉴">
          {menu.map((m) => (
            <a href={url(m.href)} aria-current={path.startsWith(m.href) ? 'page' : undefined} data-scramble="fixed">{m.label}</a>
          ))}
        </nav>
        <span class="clock mono" data-clock>SEOUL --:--:--</span>
      </div>
    </header>}
    <main class:list={{ flush }}><slot name="full" /><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap mono">
        <span>© {new Date().getFullYear()} {siteName} · Product Designer</span>
        <a href="mailto:tokyosol1992@gmail.com" data-scramble>tokyosol1992@gmail.com</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import Lenis from 'lenis';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initScramble } from '../scripts/scramble';
  import { initReveal } from '../scripts/reveal';
  import { initPageTransition } from '../scripts/page-transition';

  // 이 스크립트는 처음 한 번만 실행됨 (ClientRouter). 헤더·시계·HUD는 페이지를 넘어도 유지

  // 서울 시각 HUD
  const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  // 헤더가 없는 페이지(홈)도 있어서 매번 찾음
  const tick = () => { const clock = document.querySelector<HTMLElement>('[data-clock]'); if (clock) clock.textContent = `SEOUL ${fmt.format(new Date())}`; };
  tick();
  setInterval(tick, 1000);

  // 부드러운 스크롤 (모션 줄이기 설정이면 끔)
  const lenis = matchMedia('(prefers-reduced-motion: reduce)').matches ? null : new Lenis({ autoRaf: true });

  // 페이지 전환 C · 레티클 포커스
  initPageTransition();

  // 페이지마다: 글자 스크램블 hover(data-scramble), 스크롤 등장(.reveal)
  document.addEventListener('astro:page-load', () => {
    initScramble();
    initReveal();
    lenis?.resize();
  });
  // 떠나는 페이지의 스크롤 연출 정리
  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
