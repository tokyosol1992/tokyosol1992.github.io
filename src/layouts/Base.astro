---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; }
const { title, description = '솔길 · Product Designer 포트폴리오' } = Astro.props;
const siteName = '솔길';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} · Product Designer`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/archive', label: 'Notes' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a href={url('/')}><strong>{siteName}</strong></a>
        <nav>
          {nav.map((n) => (
            <a href={url(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site"><div class="wrap muted">© {new Date().getFullYear()} {siteName}</div></footer>
  </body>
</html>
