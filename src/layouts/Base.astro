---
import '../styles/global.css';
import { url } from '../lib/url';
import { categories } from '../lib/categories';

interface Props { title?: string; description?: string; flush?: boolean; }
const { title, description = '솔길 · Product Designer 포트폴리오', flush = false } = Astro.props;
const siteName = '솔길';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} · Product Designer`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
// 메뉴 = 항목(categories.ts) + About. 레퍼런스: huddling.ai 상단 메뉴
const menu = [
  ...categories.map((c) => ({ href: `/category/${c.slug}`, label: c.label })),
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15151c" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Silkscreen&display=swap" />
  </head>
  <body>
    <div class="hud-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <header class="site">
      <div class="wrap">
        <a class="logo" href={url('/')} data-scramble>SOLGIL<b>_</b></a>
        <nav class="menu" aria-label="메뉴">
          {menu.map((m) => (
            <a href={url(m.href)} aria-current={path.startsWith(m.href) ? 'page' : undefined} data-scramble="fixed">{m.label}</a>
          ))}
        </nav>
        <span class="clock mono" data-clock>SEOUL --:--:--</span>
      </div>
    </header>
    <main class:list={{ flush }}><slot name="full" /><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap mono">
        <span>© {new Date().getFullYear()} {siteName} · Product Designer</span>
        <a href="mailto:tokyosol1992@gmail.com" data-scramble>tokyosol1992@gmail.com</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import Lenis from 'lenis';
  import { initScramble } from '../scripts/scramble';

  // 서울 시각 HUD
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  const tick = () => { if (clock) clock.textContent = `SEOUL ${fmt.format(new Date())}`; };
  tick();
  setInterval(tick, 1000);

  // 메뉴·제목 글자 스크램블 hover (data-scramble)
  initScramble();

  // 부드러운 스크롤 (모션 줄이기 설정이면 끔)
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new Lenis({ autoRaf: true });
  }
</script>
