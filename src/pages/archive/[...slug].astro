---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection, render } from 'astro:content';
import { getItems, formatDate } from '../../lib/items';

export async function getStaticPaths() {
  const items = await getCollection('archive', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const item = (await getItems()).find((i) => i.kind === 'archive' && i.id === entry.id)!;
---
<Base title={d.title} description={d.description}>
  <Entry item={item} meta={formatDate(d.date)}>
    <Content />
  </Entry>
</Base>
