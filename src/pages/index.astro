---
import Base from '../layouts/Base.astro';
import Library from '../components/Library.astro';
import HalftoneWordmarkFooter from '@/components/ui/halftone-wordmark-footer';
import { getItems } from '../lib/items';
import { categories } from '../lib/categories';
import { url } from '../lib/url';
import rubikWoff2 from '../assets/fonts/rubik/Rubik-Latin-Variable.woff2?url';

const items = await getItems();

// 메인 화면: 하프톤 워드마크 (21st.dev halftone-wordmark-footer)
// 링크 칼럼 = 항목 · 사이트 · 연락처. 헤더 없이 이 화면이 메뉴를 겸함
const SUIT = "'SUIT Variable', 'SUIT', -apple-system, 'Apple SD Gothic Neo', system-ui, sans-serif";
// 워드마크 폰트: Rubik 900 (2026-10-26 사용자 선택)
const RUBIK = "'Rubik', 'SUIT Variable', system-ui, sans-serif";
const columns = [
  { title: 'Library', links: categories.map((c) => ({ label: c.label, href: url(`/category/${c.slug}`) })) },
  { title: 'Site', links: [
    { label: 'About', href: url('/about') },
    { label: 'Work', href: url('/work') },
    { label: 'Notes', href: url('/archive') },
  ] },
  { title: 'Contact', links: [
    { label: 'tokyosol1992@gmail.com', href: 'mailto:tokyosol1992@gmail.com' },
    { label: 'GitHub', href: 'https://github.com/tokyosol1992' },
  ] },
];
---
<Base flush header={false}>
  <link slot="head" rel="preload" href={rubikWoff2} as="font" type="font/woff2" crossorigin />
  <HalftoneWordmarkFooter
    slot="full"
    client:load
    className="home-hwf"
    wordmark="MoHo"
    narrowWordmark={'Mo\nHo'}
    crop={0.03}
    label="moho.han design"
    meta={`©${new Date().getFullYear()} · Seoul`}
    columns={columns}
    backToTop={false}
    palette={{ background: '#0b0b0d', warm: '#2895f7' }}
    fontFamily={RUBIK}
    fontWeight={900}
    monoFamily={SUIT}
    height="100svh"
  />
  <section class="home-index" id="index">
    <div class="page-head reveal">
      <span class="mono">[00] / index</span>
      <h1>작업과 기록</h1>
      <p>작업 사례와 실무에서 쓰는 팁, AI 활용법, 기록을 한곳에 모아둡니다.</p>
    </div>
    <div class="reveal"><Library items={items} /></div>
  </section>
</Base>
