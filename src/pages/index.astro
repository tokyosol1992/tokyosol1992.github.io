---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import Library from '../components/Library.astro';
import { getItems } from '../lib/items';

const items = await getItems();
---
<Base flush>
  <Intro slot="full" />
  <Hero slot="full" />
  <section class="home-index" id="index">
    <div class="page-head reveal">
      <span class="mono">[00] / index</span>
      <h1>작업과 기록</h1>
      <p>작업 사례와 실무에서 쓰는 팁, AI 활용법, 기록을 한곳에 모아둡니다.</p>
    </div>
    <div class="reveal"><Library items={items} /></div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  for (const el of document.querySelectorAll('.reveal')) {
    gsap.to(el, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 85%' } });
  }
</script>
