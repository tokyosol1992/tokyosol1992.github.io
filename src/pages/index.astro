---
import Base from '../layouts/Base.astro';
import Library from '../components/Library.astro';
import { getItems } from '../lib/items';

const items = await getItems();
---
<Base>
  <section class="hero">
    <h1>플랫폼과 디자인 시스템을 만드는<br />프로덕트 디자이너 솔길입니다.</h1>
    <p class="muted">작업 사례와 실무에서 쓰는 팁, AI 활용법, 기록을 한곳에 모아둡니다.</p>
  </section>
  <Library items={items} active="all" />
</Base>
