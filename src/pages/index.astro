---
import Base from '../layouts/Base.astro';
import Library from '../components/Library.astro';
import HalftoneWordmarkFooter from '@/components/ui/halftone-wordmark-footer';
import SmokeField from '@/components/ui/smoke-field';
import { Image } from 'astro:assets';
import { getItems } from '../lib/items';
import { getCategory } from '../lib/categories';
import { url } from '../lib/url';
import hahmletWoff2 from '../assets/fonts/hahmlet/Hahmlet-Latin-900.woff2?url';

const items = await getItems();
const works = items.filter((i) => i.kind === 'work').slice(0, 3);

// 메인 화면: 하프톤 워드마크 (21st.dev halftone-wordmark-footer)
// 메뉴는 상단 헤더(Base)가 맡음 → 이 화면은 워드마크와 라벨만
// 색: 브랜드 파랑 하나로 통일 (연기 · 클릭 파동 · 마우스에 밀린 점). 흰색은 파랑 쪽으로 살짝 기운 쿨 화이트 (global.css --fg와 같은 값)
const BRAND = '#2895f7';
const WHITE = '#f2f7ff';
const SUIT = "'SUIT Variable', 'SUIT', -apple-system, 'Apple SD Gothic Neo', system-ui, sans-serif";
// 워드마크 폰트: Hahmlet 900 (바탕체 계열, 2026-10-26 Rubik에서 교체)
const WORDMARK = "'Hahmlet', 'SUIT Variable', serif";
---
<Base flush>
  <link slot="head" rel="preload" href={hahmletWoff2} as="font" type="font/woff2" crossorigin />
  <div class="home-hero" slot="full">
  <HalftoneWordmarkFooter
    client:load
    className="home-hwf"
    wordmark="MoHo"
    narrowWordmark={'Mo\nHo'}
    crop={0.03}
    label="moho design"
    meta={`©${new Date().getFullYear()} · Seoul`}
    columns={[]}
    backToTop={false}
    palette={{ background: 'transparent', ink: WHITE, warm: BRAND }}
    grain={0}
    fontFamily={WORDMARK}
    fontWeight={900}
    monoFamily={SUIT}
    height="100svh"
  />
  <!-- 글자 뒤에서 피어오르는 연기 + 마우스를 따라 번짐 (레퍼런스: junheedot.com 히어로) -->
  <!-- 연하고 몽글몽글하게, 느리게 피어남, 좁게 퍼짐: 옅은 하늘빛, 작은 퍼프, 소용돌이 약하게, 슬로모션(speed 0.5), 마우스 힘 약하게 -->
  <SmokeField client:load className="home-smoke" color={BRAND} intensity={0.04} idleIntensity={0.13}
    radius={0.26} curl={6} rise={0.5} puffSpeed={[60, 150]} dissipation={0.65} speed={0.5} force={2500} sourceEvery={[0.6, 1.3]} sourceBand={[0.3, 0.46]} />
  </div>
  <section class="hs" id="about">
    <div class="hs-head" data-blur>
      <span class="mono">About</span>
      <h2>플랫폼과 디자인 시스템을 만드는 프로덕트 디자이너 솔길입니다.</h2>
      <p data-scroll-words>8년 동안 서비스의 구조와 규칙을 설계해 왔습니다. 작업 사례와 실무에서 쓰는 팁, AI 활용법을 함께 기록합니다.</p>
    </div>
    <div class="hs-tiles reveal">
      <div class="hs-tile"><span class="mono">Experience</span><b><i data-countup="8">8</i>년 차</b><span>프로덕트 디자이너</span></div>
      <div class="hs-tile"><span class="mono">Focus</span><b>플랫폼 · 디자인 시스템</b><span>구조와 규칙을 만드는 일</span></div>
      <div class="hs-tile"><span class="mono">Since</span><b><i data-countup="2016" data-from="2000">2016</i> –</b><span>Seoul</span></div>
    </div>
  </section>

  <section class="hs" id="work">
    <div class="hs-head" data-blur>
      <span class="mono">Work</span>
      <h2>대표 프로젝트</h2>
      <p>문제 · 과정 · 결과로 정리한 케이스 스터디입니다.</p>
    </div>
    <div class="hs-cards reveal">
      {works.map((w) => {
        const cat = getCategory(w.category);
        const meta = [w.company, w.role, w.period].filter(Boolean);
        return (
          <a class="hs-card" href={url(w.href)} style={`--h: ${cat.hue}`} data-spot>
            <div class="hs-thumb">
              {w.cover && <Image src={w.cover} alt="" widths={[600, 900]} sizes="(min-width: 960px) 380px, 100vw" />}
              <span class="mono">{cat.label}</span>
            </div>
            <div class="hs-body">
              <h3>{w.title}</h3>
              {w.summary && <p>{w.summary}</p>}
              {meta.length > 0 && <div class="hs-meta">{meta.map((m) => <span>{m}</span>)}</div>}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="hs" id="library">
    <div class="hs-head" data-blur>
      <span class="mono">Library</span>
      <h2>팁, AI 활용, 툴, 기록</h2>
      <p>항목은 메뉴가 아니라 필터로 고릅니다. 글이 늘어도 메뉴는 그대로입니다.</p>
    </div>
    <div class="reveal"><Library items={items} categoryFilter /></div>
  </section>

  <section class="hs" id="contact">
    <div class="hs-head" data-blur>
      <span class="mono">Contact</span>
      <h2>함께 이야기해요</h2>
      <p>메일이 가장 빠릅니다.</p>
    </div>
    <div class="hs-contact reveal">
      <a href="mailto:tokyosol1992@gmail.com" data-spot><span class="mono"><span>Email</span><span>↗</span></span><b>tokyosol1992@gmail.com</b></a>
      <a href="https://github.com/tokyosol1992" target="_blank" rel="noopener" data-spot><span class="mono"><span>GitHub</span><span>↗</span></span><b>tokyosol1992</b></a>
      <a href="https://tokyosol1992.github.io/ohsolgil" target="_blank" rel="noopener" data-spot><span class="mono"><span>Portfolio</span><span>↗</span></span><b>Oh SolGil</b></a>
    </div>
  </section>
</Base>
